# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

# Added in for node and JS dependencies
/node_modules
**/node_modules/

# Veilid local data stores
.veilid/

# Rust ICE dumps
rustc-ice-*.txt

# Local environment overrides
.env
.env.local
.env.*.local

# Signing material — never committed. CI writes the android keystore into the
# already-ignored target/ at run time; this catches an accidental copy to the
# repository root. The only copy lives outside the tree (~/.po/).
*.jks
*.keystore

# Native plugin build artifacts
native/apple/.build/
native/android/**/build/
native/android/**/.gradle/

# Generated assets
/assets/tailwind.css

# Tandem e2e run evidence (logs, screenshots, result.json)
/test/runs/

