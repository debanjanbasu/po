/.well-known/*
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/
  Link: </fonts/3270-Regular.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
  Cache-Control: public, max-age=3600, s-maxage=86400

/privacy/*
  Cache-Control: public, max-age=86400, s-maxage=604800

/terms/*
  Cache-Control: public, max-age=86400, s-maxage=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
