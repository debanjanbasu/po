---
import Base from '../layouts/Base.astro';
import about from '../../../shared/about.json';
---

<Base
  title="po — Decentralized Messenger"
  description={about.description}
>
  <div class="flex min-h-dvh items-center justify-center p-4 sm:p-8">
    <section
      class="card landing-card w-full max-w-3xl border border-base-content/10 bg-base-100/95 shadow-2xl"
      aria-labelledby="site-title"
    >
      <div class="card-body items-center gap-5 p-5 text-center sm:gap-7 sm:p-8 lg:p-10">
        <header class="flex flex-col items-center gap-2">
          <img src="/logo.svg" alt="" width="72" height="72" class="mb-1 h-16 w-16 sm:h-[4.5rem] sm:w-[4.5rem]" fetchpriority="high" />
          <h1 id="site-title" class="text-5xl font-bold tracking-[0.2em]">po</h1>
          <p class="max-w-prose text-base-content/65">{about.tagline}</p>
        </header>

        <!-- Contact invite -->
        <section id="contact" class="hidden w-full" aria-labelledby="contact-title">
          <h2 id="contact-title" class="mb-1 text-xl font-semibold">Connect with</h2>
          <p class="mb-4 text-2xl font-bold text-secondary" id="display-name"></p>
          <a id="open-app" class="btn btn-secondary mb-3 min-h-12 w-full" href="#">Open in po</a>
          <div class="divider my-2 text-base-content/65">Or copy identity and paste in the app</div>
          <div class="join w-full">
            <input
              id="identity-str"
              class="join-item input input-sm h-12 min-w-0 flex-1 bg-base-200 font-mono text-sm text-base-content"
              type="text"
              value=""
              readonly
              spellcheck="false"
              aria-label="Contact identity"
              aria-describedby="copy-status"
            />
            <button id="copy-btn" type="button" class="join-item btn btn-ghost h-12 bg-base-200 px-5">Copy</button>
          </div>
          <p id="copy-status" class="mt-2 min-h-6 text-left text-sm" role="status" aria-live="polite" aria-atomic="true"></p>
        </section>

        <!-- Device pairing -->
        <section id="pairing" class="hidden w-full" aria-labelledby="pairing-title">
          <h2 id="pairing-title" class="mb-2 text-xl font-semibold">Device pairing</h2>
          <p class="mx-auto mb-5 max-w-prose text-base-content/65">Open this link on your new device with the po app installed.</p>
          <a id="pair-app" class="btn btn-secondary min-h-12 w-full" href="#">Open in po</a>
        </section>

        <!-- Marketing home -->
        <section id="home" class="w-full" aria-labelledby="home-title">
          <div class="mx-auto mb-6 max-w-2xl">
            <h2 id="home-title" class="mb-2 text-2xl font-bold tracking-tight sm:text-3xl">{about.description.split('.')[0]}.</h2>
            <p class="text-base leading-relaxed text-base-content/70">{about.description.split('.').slice(1).join('.').trim()}</p>
          </div>

          <ul class="grid grid-cols-1 gap-3 text-left sm:grid-cols-2 lg:grid-cols-3" aria-label="Features">
            {about.features.map((f) => (
              <li class="feature-tile rounded-box border border-base-content/10 bg-base-200/70 p-4">
                <span class={`${f.icon} text-2xl text-secondary`} aria-hidden="true"></span>
                <h3 class="mt-2 font-semibold leading-snug">{f.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-base-content/65">{f.detail}</p>
              </li>
            ))}
          </ul>

          <div class="divider my-5 text-base-content/65">Powered by</div>
          <ul class="flex list-none flex-wrap justify-center gap-2 p-0" aria-label="Technology">
            {about.tech_badges.map((badge) => (
              <li class="badge badge-outline px-3 py-3">{badge}</li>
            ))}
          </ul>
        </section>

        <aside class="w-full rounded-box border border-base-content/10 bg-base-200/60 p-4 text-left sm:p-5" aria-labelledby="install-status-title">
          <h2 id="install-status-title" class="mb-1 font-semibold">Native install status</h2>
          <p class="mb-4 text-sm leading-relaxed text-base-content/65">
            App-store listings and signed desktop downloads are not public yet. If po is already installed on this device, the open button above will hand off directly to the app.
          </p>
        </aside>

        <p id="status" class="min-h-6 w-full text-center text-sm text-base-content/65" role="status" aria-live="polite" aria-atomic="true"></p>

        <footer class="w-full border-t border-base-content/10 pt-4">
          <nav class="flex justify-center gap-6 text-sm text-base-content/65" aria-label="Legal">
            <a href="/privacy/" class="link link-hover">Privacy</a>
            <a href="/terms/" class="link link-hover">Terms</a>
          </nav>
        </footer>
      </div>
    </section>
  </div>

  <script>
    import {
      buildContactDeepLink,
      buildContactIdentity,
      buildPairingDeepLink,
      parseShareRoute,
    } from '../lib/share-route';

      const contactEl = document.getElementById('contact');
      const pairingEl = document.getElementById('pairing');
      const homeEl = document.getElementById('home');
      const statusEl = document.getElementById('status');
      const copyStatusEl = document.getElementById('copy-status');
      const identityInput = document.getElementById('identity-str') as HTMLInputElement | null;

      const route = parseShareRoute(window.location);
      if (route?.kind === 'contact') {
        showContact(route.username, route.dhtKey);
      } else if (route?.kind === 'pairing') {
        showPairing(route.payload);
      }

      function showContact(username: string, dhtKey: string) {
        homeEl!.classList.add('hidden');
        const deepLink = buildContactDeepLink(username, dhtKey);
        const openBtn = document.getElementById('open-app') as HTMLAnchorElement | null;

        document.getElementById('display-name')!.textContent = '@' + username;
        if (identityInput) {
          identityInput.value = buildContactIdentity(username, dhtKey);
        }
        clearCopyStatus();
        statusEl!.textContent = '';
        if (deepLink !== null && openBtn) {
          openBtn.href = deepLink;
          openBtn.addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = deepLink;
          });
        } else if (openBtn) {
          // No representable deep link (e.g. multibyte identity): fall back
          // to manual copy/paste.
          openBtn.classList.add('hidden');
          statusEl!.textContent = 'Copy the identity below and paste it in the app to connect.';
        }
        contactEl!.classList.remove('hidden');
      }

      function showPairing(payload: string) {
        homeEl!.classList.add('hidden');
        const deepLink = buildPairingDeepLink(payload);
        statusEl!.textContent = '';
        (document.getElementById('pair-app') as HTMLAnchorElement).href = deepLink;
        pairingEl!.classList.remove('hidden');

        document.getElementById('pair-app')!.addEventListener('click', function (e) {
          e.preventDefault();
          window.location.href = deepLink;
        });
      }

      function setCopyStatus(message: string, isError: boolean) {
        if (!copyStatusEl) return;
        copyStatusEl.textContent = message;
        copyStatusEl.classList.remove('hidden', 'text-success', 'text-error');
        copyStatusEl.classList.add(isError ? 'text-error' : 'text-success');
      }

      function clearCopyStatus() {
        if (!copyStatusEl) return;
        copyStatusEl.textContent = '';
        copyStatusEl.classList.add('hidden');
        copyStatusEl.classList.remove('text-success', 'text-error');
      }

      function flashCopyButton(label: string) {
        const btn = document.getElementById('copy-btn');
        if (!btn) return;
        btn.textContent = label;
        setTimeout(function () {
          btn.textContent = 'Copy';
        }, 2000);
      }

      function selectIdentityText() {
        if (!identityInput) return;
        identityInput.focus();
        identityInput.select();
        identityInput.setSelectionRange(0, identityInput.value.length);
      }

      function tryLegacyCopy() {
        if (!identityInput) return false;
        selectIdentityText();
        try {
          return document.execCommand('copy');
        } catch {
          return false;
        }
      }

      document.getElementById('copy-btn')!.addEventListener('click', async function () {
        const code = identityInput?.value ?? '';
        clearCopyStatus();
        try {
          if (!navigator.clipboard?.writeText) {
            throw new Error('Clipboard API unavailable');
          }
          await navigator.clipboard.writeText(code);
          flashCopyButton('Copied!');
          setCopyStatus('Copied to clipboard.', false);
          return;
        } catch {}

        if (tryLegacyCopy()) {
          flashCopyButton('Copied!');
          setCopyStatus('Copied to clipboard.', false);
          return;
        }

        selectIdentityText();
        flashCopyButton('Selected');
        setCopyStatus(
          'Clipboard access is unavailable. The identity is selected so you can copy it manually.',
          true,
        );
      });
  </script>
</Base>
